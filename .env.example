# Agri Smart AI Configuration Environment Variables
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=agri-smart-ai-production-secret-key-change-in-production
AGRI_DB_PATH=database/agri_smart.db
PORT=5000

# Optional OpenWeatherMap Live Weather API Key (Leave empty to use historical dataset analytics)
WEATHER_API_KEY=

# Optional AI Assistant API Key Configuration (Google Gemini or OpenAI)
# Leave empty to keep AI Assistant in standing-by mode with clear configuration notice
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Alternatively, configure OpenAI API Key:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
